# ============================================
# Redirecionamentos SEO - Byte-Ag.com.br
# ============================================

# Ativar o módulo de reescrita
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# ============================================
# 1. FORÇAR HTTPS (HTTP -> HTTPS)
# ============================================
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ============================================
# 2. FORÇAR WWW (sem www -> com www)
# ============================================
RewriteCond %{HTTP_HOST} ^byte-ag\.com\.br$ [NC]
RewriteRule ^(.*)$ https://www.byte-ag.com.br/$1 [L,R=301]

# ============================================
# 3. REDIRECIONAR URLs SEM .HTML PARA COM .HTML
# (Apenas para páginas de serviços)
# ============================================
# Redireciona /servicos/gestao-de-trafego-pago para /servicos/gestao-de-trafego-pago.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/servicos/([^/]+)/?$ [NC]
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^servicos/([^/]+)/?$ /servicos/$1.html [L,R=301]

# ============================================
# 4. CORRIGIR ERROS 404 ESPECÍFICOS
# ============================================
# Redireciona versão sem www da página inicial
RewriteCond %{HTTP_HOST} ^byte-ag\.com\.br$ [NC]
RewriteRule ^$ https://www.byte-ag.com.br/ [L,R=301]

# Redireciona /servicos/seo-para-negocios.html se estiver acessando sem o caminho correto
RewriteCond %{REQUEST_URI} ^/seo-para-negocios\.html$ [NC]
RewriteRule ^seo-para-negocios\.html$ /servicos/seo-para-negocios.html [L,R=301]

# Redireciona /servicos/google-meu-negocio.html sem www
RewriteCond %{HTTP_HOST} ^byte-ag\.com\.br$ [NC]
RewriteCond %{REQUEST_URI} ^/servicos/google-meu-negocio\.html$ [NC]
RewriteRule ^servicos/google-meu-negocio\.html$ https://www.byte-ag.com.br/servicos/google-meu-negocio.html [L,R=301]

# ============================================
# 5. REMOVER BARRA FINAL DUPLICADA
# ============================================
RewriteCond %{REQUEST_URI} ^(.*)//(.*)$
RewriteRule . %1/%2 [R=301,L]

# ============================================
# 6. REMOVER BARRA FINAL DE ARQUIVOS
# ============================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [R=301,L]

# ============================================
# 7. COMPRESSÃO GZIP (Performance)
# ============================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# ============================================
# 8. CACHE DO NAVEGADOR (Performance)
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ============================================
# 9. SEGURANÇA - PREVENIR LISTAGEM DE DIRETÓRIOS
# ============================================
Options -Indexes

# ============================================
# 10. HEADERS DE SEGURANÇA
# ============================================
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

